# --- Пример настроек LLM-прокси ---
# Скопируйте в .env рядом с сервисом на машине с VPN и заполните ключи/модели.

# Сеть, на которой слушает прокси (на VPN-машине).
LLM_PROXY_HOST=0.0.0.0
LLM_PROXY_PORT=8080

# Порядок fallback: сначала codex, затем chatgpt, затем LM Studio.
LLM_PROXY_CHAIN=codex,chatgpt,lmstudio

# Таймаут по умолчанию (сек) для upstream-запросов, если не задан у backend-а.
LLM_PROXY_TIMEOUT_SECONDS=120

# --- Codex (используем Claude Sonnet) ---
# Слот codex настроен на Anthropic Sonnet (рабочий ключ), а не на OpenAI codex.
LLM_PROXY_CODEX_STYLE=anthropic
LLM_PROXY_CODEX_BASE_URL=https://api.anthropic.com
LLM_PROXY_CODEX_MODEL=claude-sonnet-4-6
LLM_PROXY_CODEX_API_KEY_ENV=OPENAI_API_KEY_CLAUDE

# Если всё же нужен именно OpenAI codex — раскомментируйте (нужен /v1/responses):
# LLM_PROXY_CODEX_STYLE=openai_responses
# LLM_PROXY_CODEX_BASE_URL=https://api.openai.com
# LLM_PROXY_CODEX_MODEL=gpt-5-codex
# LLM_PROXY_CODEX_API_KEY_ENV=OPENAI_API_KEY

# --- ChatGPT (OpenAI) ---
LLM_PROXY_CHATGPT_BASE_URL=https://api.openai.com
LLM_PROXY_CHATGPT_MODEL=gpt-4o
LLM_PROXY_CHATGPT_API_KEY_ENV=OPENAI_API_KEY

# --- LM Studio (локальный сервер) ---
LLM_PROXY_LMSTUDIO_BASE_URL=http://192.168.1.157:1234
LLM_PROXY_LMSTUDIO_MODEL=openai/gpt-oss-120b

# Сами ключи (можно держать прямо здесь или в системном окружении).
OPENAI_API_KEY_CLAUDE=sk-ant-...
OPENAI_API_KEY=sk-...

# --- MinIO (аватары агентов и пользователей) ---
# Endpoint без схемы, как у docker/minio-postgres (порт 9000).
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agent-constructor
MINIO_SECURE=false

# --- Postgres (пользователи системы) ---
# Если на хосте уже занят 5432 (локальный Postgres) — в docker/.env
# поставьте POSTGRES_HOST_PORT=5433 и укажите тот же порт здесь.
DATABASE_URL=postgresql+psycopg://agent:agent@127.0.0.1:5433/agent_constructor
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=72
ADMIN_TOKEN=change-me-admin-token
USER_SYNC_INTERVAL_HOURS=24
# Ежедневно в 03:00 (APScheduler cron). Celery не требуется.
USER_SYNC_CRON=0 3 * * *
USER_SYNC_ON_STARTUP=true

# --- 1С SQL Server (erp_pm), read-only. Можно скопировать из export_1c_users/.env ---
DB_SERVER=192.168.1.157
DB_NAME=erp_pm
DB_PORT=1433
# TrustedConnection=yes — Windows/SSPI.
#   Если текущая учётка процесса не пускается на SQL, укажите DB_USER/DB_PASSWORD
#   доменной учётки (например TURBO-DON\testii): перед connect они кладутся в
#   Credential Manager через cmdkey, и SSPI идёт уже от них.
# TrustedConnection=no — классический SQL-login (UID/PWD).
TrustedConnection=yes
DB_USER=
DB_PASSWORD=
ODBC_DRIVER=ODBC Driver 18 for SQL Server
# Опционально переопределить SQL подразделений (иначе авто: v8users →
# Справочник.Пользователи → Справочник.Подразделения).
# Ожидаемые колонки: MapKey, Department — или UserId, Login, DisplayName, Department.
# ONC_DEPARTMENT_SQL=
